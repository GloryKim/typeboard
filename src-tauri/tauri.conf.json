{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typeboard",
  "version": "0.1.0",
  "identifier": "com.async.typeboard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "typeboard",
        "width": 980,
        "height": 640,
        "minWidth": 400,
        "minHeight": 220,
        "backgroundColor": "#1e1e2e",
        "theme": "Dark",
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
